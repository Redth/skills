    "sidebar-toggle": {
      "sf": "sidebar.left",
      "gtk": "sidebar-show-symbolic",
      "fluent": "E700",
      "svg": "<rect x='3' y='4' width='18' height='16' rx='2'/><path d='M9 4v16'/>"
    },
    "trash": {
      "sf": "trash",
      "gtk": "user-trash-symbolic",
      "fluent": "E74D",
      "svg": "<path d='M4 7h16M10 7V4.5h4V7M6.5 7l1 12.5h9l1-12.5M10.5 11v5M13.5 11v5'/>"
    }
  },
  "marks": {
    "$comment": "The app's own marks, which no platform names (a status-item or tray glyph): {\"svg\": \"<path d='…'/>\"}, same geometry rules. Each becomes a mark-<name> sprite symbol, Icons.MarkSvg(name, stroke) and, with outputs.macosMarks, a template image set."
  }
}

      "gtk": "go-previous-symbolic",
      "fluent": "E76B",
      "svg": "<path d='m15 5-7 7 7 7'/>"
    },
    "chevron-right": {
      "sf": "chevron.right",
      "gtk": "go-next-symbolic",

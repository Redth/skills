{
  "$comment": [
    "Every icon the app's chrome and content use, mapped per platform (CONTRACT.md section 5). icons.py build",
    "generates Icons.g.cs (IconRef and the resolution tables), the SVG sprite and IconSprite.razor from it.",
    "sf: an SF Symbol name (macOS). gtk: an Adwaita icon name (GTK). fluent: a Segoe Fluent Icons codepoint in hex",
    "(Windows, when meta.windows is fluent; with svg, Windows draws the sprite geometry). svg: stroke geometry on",
    "the 24x24 viewBox, painted with currentColor.",
    "These names and codepoints are a best-effort starting set: check each in the SF Symbols app, in the icon",
    "theme the Linux build ships with (adwaita-icon-theme) and in the Segoe Fluent Icons reference before relying",
    "on it. Add the app's own icons the same way; a platform listed in platforms with no mapping fails the build."
  ],
  "version": 1,
  "meta": {"name": "App", "csharpPrefix": "App", "windows": "svg"},
  "platforms": ["macos", "windows", "linux", "web"],
  "outputs": {
    "$comment": "icons.py init fills these from the project's layout. Paths are relative to the project root."
  },
  "geometry": {"viewBox": "0 0 24 24", "strokeWidth": 1.75, "linecap": "round", "linejoin": "round"},
  "icons": {
    "add": {
      "sf": "plus",
      "gtk": "list-add-symbolic",
      "fluent": "E710",
      "svg": "<path d='M12 5v14M5 12h14'/>"
    },
    "remove": {"sf": "minus", "gtk": "list-remove-symbolic", "fluent": "E738", "svg": "<path d='M5 12h14'/>"},
    "edit": {
      "sf": "pencil",
      "gtk": "document-edit-symbolic",
      "fluent": "E70F",
      "svg": "<path d='M4 20h4L19 9a2.12 2.12 0 0 0-3-3L5 17v3Z'/><path d='m14.5 7.5 3 3'/>"
    },
    "refresh": {
      "sf": "arrow.clockwise",
      "gtk": "view-refresh-symbolic",
      "fluent": "E72C",
      "svg": "<path d='M20 11a8 8 0 1 0-2.3 5.7'/><path d='M20 4v7h-7'/>"
    },
    "search": {
      "sf": "magnifyingglass",
      "gtk": "system-search-symbolic",
      "fluent": "E721",
      "svg": "<circle cx='11' cy='11' r='6.5'/><path d='m16 16 4.5 4.5'/>"
    },
    "settings": {
      "sf": "gearshape",
      "gtk": "emblem-system-symbolic",
      "fluent": "E713",
      "svg": "<circle cx='12' cy='12' r='3'/><circle cx='12' cy='12' r='6.5'/><path d='M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1'/>"
    },
    "close": {
      "sf": "xmark",
      "gtk": "window-close-symbolic",
      "fluent": "E711",
      "svg": "<path d='m6 6 12 12M18 6 6 18'/>"
    },
    "chevron-left": {

{
  "$comment": [
    "Every colour, size and duration the app uses, written once. tokens.py build generates the CSS custom",
    "properties, the C# palette and scale for native chrome, the macOS accent colour set and DESIGN.md's tables;",
    "tokens.py contrast checks every pair below for both themes and each platform. Components reference",
    "semantic roles and scale names only, never primitives and never raw values.",
    "Colours are OKLCH [L, C, H] (or [L, C, H, A]); sRGB hex works too. Keys starting with $ are comments."
  ],
  "version": 1,
  "meta": { "name": "App", "csharpPrefix": "App", "colorSpace": "oklch" },
  "outputs": {
    "$comment": "tokens.py init fills these from the project's layout. Paths are relative to the project root."
  },
  "root": ":root",
  "primitives": {
    "$comment": [
      "Never referenced by a component: semantic roles point at these.",
      "Surfaces and inks are pure neutrals (chroma 0) so they never pick up a tint next to the accent.",
      "brand-* is a placeholder accent: replace it with the app's brand colour, then run tokens.py contrast.",
      "For look.accent = platform, add each platform's accent here (macOS #007aff / #0a84ff, Windows 11",
      "#0067c0 / #4cc2ff, GNOME #3584e4 / #78aeed) and override the accent roles under platforms.<p>.semantic.",
      "White text on the macOS and GNOME blues is under 4.5:1: declare that as a contrast exception if you match them."
    ],
    "white": [1, 0, 0],
    "neutral-970": [0.97, 0, 0],
    "neutral-975": [0.975, 0, 0],
    "neutral-955": [0.955, 0, 0],
    "neutral-935": [0.935, 0, 0],
    "neutral-930": [0.93, 0, 0],
    "neutral-840": [0.84, 0, 0],
    "neutral-720": [0.72, 0, 0],
    "neutral-700": [0.7, 0, 0],
    "neutral-520": [0.52, 0, 0],
    "neutral-440": [0.44, 0, 0],
    "neutral-320": [0.32, 0, 0],
    "neutral-305": [0.305, 0, 0],
    "neutral-295": [0.295, 0, 0],
    "neutral-270": [0.27, 0, 0],
    "neutral-250": [0.25, 0, 0],
    "neutral-235": [0.235, 0, 0],
    "neutral-225": [0.225, 0, 0],
    "neutral-210": [0.21, 0, 0],
    "neutral-190": [0.19, 0, 0],
    "black-a06": [0, 0, 0, 0.06],
    "black-a08": [0, 0, 0, 0.08],
    "black-a14": [0, 0, 0, 0.14],
    "black-a22": [0, 0, 0, 0.22],
    "white-a07": [1, 0, 0, 0.07],
    "white-a09": [1, 0, 0, 0.09],
    "white-a13": [1, 0, 0, 0.13],
    "white-a20": [1, 0, 0, 0.2],
    "brand-470": [0.47, 0.16, 262],
    "brand-510": [0.51, 0.165, 262],
    "brand-530": [0.53, 0.17, 262],
    "brand-560": [0.56, 0.17, 262],
    "brand-750": [0.75, 0.12, 258],
    "green-500": [0.5, 0.13, 150],
    "green-620": [0.62, 0.17, 150],
    "green-760": [0.76, 0.17, 150],
    "green-800": [0.8, 0.17, 150],
    "amber-530": [0.53, 0.12, 60],
    "amber-650": [0.65, 0.14, 62],
    "amber-820": [0.82, 0.15, 80],
    "amber-840": [0.84, 0.15, 84],
    "red-500": [0.5, 0.19, 27],
    "red-520": [0.52, 0.19, 27],
    "red-550": [0.55, 0.19, 27],
    "red-580": [0.58, 0.21, 27],
    "red-680": [0.68, 0.18, 22],
    "red-740": [0.74, 0.15, 22],
    "blue-490": [0.49, 0.19, 264],
    "blue-560": [0.56, 0.2, 262],
    "blue-700": [0.7, 0.14, 255],
    "blue-750": [0.75, 0.12, 255]
  },
  "semantic": {
    "$comment": [
      "What components use. The surface ladder: bg (the window's canvas), surface (cards, grouped lists),",
      "surface-well (insets and sidebars), surface-control (inputs and secondary buttons), surface-popover",
      "(menus and popovers), surface-console (terminals and logs, dark in both themes). Separate surfaces with",
      "1px border-subtle or border-hairline lines, not shadows. accent is the filled-button colour; accent-ink",
      "is the accent as text or an icon on the canvas. Status tints are opaque mixes, so their text pairs can",
      "be checked."
    ],
    "light": {
      "bg": "white",
      "surface": "neutral-975",
      "surface-hover": "neutral-955",
      "surface-well": "neutral-955",
      "surface-control": "white",
      "surface-popover": "white",
      "surface-console": "neutral-190",
      "surface-console-header": "neutral-225",
      "ink": "neutral-210",
      "ink-secondary": "neutral-440",
      "ink-muted": "neutral-520",
      "console-ink": "neutral-930",
      "console-muted": "neutral-700",
      "border-hairline": "black-a06",
      "border-subtle": "black-a08",
      "border-control": "black-a14",
      "border-strong": "black-a22",
      "accent": "brand-530",
      "accent-hover": "brand-470",
      "accent-ink": "brand-530",
      "accent-soft": { "mix": "brand-530", "into": "white", "amount": 0.12 },
      "accent-border": { "mix": "brand-530", "into": "white", "amount": 0.4 },
      "on-accent": "white",
      "focus": "brand-530",
      "success-fg": "green-500",
      "success-bg": { "mix": "green-620", "into": "white", "amount": 0.12 },
      "success-border": { "mix": "green-620", "into": "white", "amount": 0.35 },
      "success-dot": "green-620",
      "warning-fg": "amber-530",
      "warning-bg": { "mix": "amber-650", "into": "white", "amount": 0.12 },
      "warning-border": { "mix": "amber-650", "into": "white", "amount": 0.35 },
      "warning-dot": "amber-650",
      "danger-fg": "red-500",
      "danger-bg": { "mix": "red-580", "into": "white", "amount": 0.12 },
      "danger-border": { "mix": "red-580", "into": "white", "amount": 0.35 },
      "danger-dot": "red-580",
      "danger-fill": "red-520",
      "on-danger": "white",
      "info-fg": "blue-490",
      "info-bg": { "mix": "blue-560", "into": "white", "amount": 0.12 },
      "info-border": { "mix": "blue-560", "into": "white", "amount": 0.35 },
      "info-dot": "blue-560"
    },
    "dark": {
      "bg": "neutral-235",
      "surface": "neutral-270",
      "surface-hover": "neutral-305",
      "surface-well": "neutral-250",
      "surface-control": "neutral-320",
      "surface-popover": "neutral-295",
      "surface-console": "neutral-190",
      "surface-console-header": "neutral-225",
      "ink": "neutral-970",
      "ink-secondary": "neutral-840",
      "ink-muted": "neutral-720",
      "console-ink": "neutral-930",
      "console-muted": "neutral-700",
      "border-hairline": "white-a07",
      "border-subtle": "white-a09",
      "border-control": "white-a13",
      "border-strong": "white-a20",
      "accent": "brand-560",
      "accent-hover": "brand-510",
      "accent-ink": "brand-750",
      "accent-soft": { "mix": "brand-560", "into": "neutral-235", "amount": 0.22 },
      "accent-border": { "mix": "brand-560", "into": "neutral-235", "amount": 0.5 },
      "on-accent": "white",
      "focus": "brand-750",
      "success-fg": "green-800",
      "success-bg": { "mix": "green-760", "into": "neutral-235", "amount": 0.16 },
      "success-border": { "mix": "green-760", "into": "neutral-235", "amount": 0.35 },
      "success-dot": "green-760",
      "warning-fg": "amber-840",
      "warning-bg": { "mix": "amber-820", "into": "neutral-235", "amount": 0.16 },
      "warning-border": { "mix": "amber-820", "into": "neutral-235", "amount": 0.35 },
      "warning-dot": "amber-820",
      "danger-fg": "red-740",
      "danger-bg": { "mix": "red-680", "into": "neutral-235", "amount": 0.16 },
      "danger-border": { "mix": "red-680", "into": "neutral-235", "amount": 0.35 },
      "danger-dot": "red-680",
      "danger-fill": "red-550",
      "on-danger": "white",
      "info-fg": "blue-750",
      "info-bg": { "mix": "blue-700", "into": "neutral-235", "amount": 0.16 },
      "info-border": { "mix": "blue-700", "into": "neutral-235", "amount": 0.35 },
      "info-dot": "blue-700"
    }
  },
  "effects": {
    "$comment": "Compositing effects, emitted verbatim per theme. Elevation is surfaces and hairlines; shadows are for floating layers only.",
    "light": {
      "shadow-control": "0 1px 1px oklch(0 0 0 / 4%)",
      "shadow-popover": "0 10px 28px oklch(0 0 0 / 12%), 0 2px 6px oklch(0 0 0 / 6%)",
      "shadow-dialog": "0 18px 48px oklch(0 0 0 / 20%)",
      "scrim": "oklch(0 0 0 / 32%)"
    },
    "dark": {
      "shadow-control": "0 1px 1px oklch(0 0 0 / 25%)",
      "shadow-popover": "0 14px 36px oklch(0 0 0 / 55%), 0 2px 6px oklch(0 0 0 / 35%)",
      "shadow-dialog": "0 24px 64px oklch(0 0 0 / 60%)",
      "scrim": "oklch(0 0 0 / 55%)"
    }
  },
  "scale": {
    "$comment": "Each entry becomes --<$prefix><name>; an object entry adds -<key> for each key but $base.",
    "font": {
      "$prefix": "font-",
      "sans": "system-ui, -apple-system, \"Segoe UI\", \"Adwaita Sans\", Cantarell, sans-serif",
      "mono": "ui-monospace, \"SF Mono\", \"Cascadia Code\", \"Adwaita Mono\", Menlo, Consolas, monospace"
    },
    "text": {
      "$prefix": "text-",
      "$base": "size",
      "xs": { "size": "11px", "weight": 400, "lh": 1.35 },
      "sm": { "size": "12px", "weight": 400, "lh": 1.4 },
      "base": { "size": "14px", "weight": 400, "lh": 1.45 },
      "lg": { "size": "16px", "weight": 600, "lh": 1.35 },
      "title": { "size": "20px", "weight": 600, "lh": 1.25 },
      "display": { "size": "28px", "weight": 600, "lh": 1.2 }
    },
    "space": {
      "$prefix": "space-",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "12": "48px"
    },
    "radius": {
      "$prefix": "radius-",
      "xs": "4px",
      "sm": "6px",
      "md": "8px",
      "lg": "12px",
      "xl": "16px",
      "pill": "9999px"
    },
    "control": {
      "$prefix": "control-",
      "height-sm": "26px",
      "height-md": "30px",
      "height-lg": "36px",
      "padding-x": "12px"
    },
    "row": {
      "$prefix": "row-",
      "padding-y": "10px",
      "padding-x": "14px"
    },
    "z": {
      "$prefix": "z-",
      "sticky": 10,
      "dropdown": 20,
      "popover": 30,
      "overlay": 40,
      "dialog": 50,
      "toast": 60,
      "tooltip": 70
    },
    "motion": {
      "$prefix": "motion-",
      "fast": "100ms",
      "normal": "160ms",
      "slow": "240ms",
      "ease": "cubic-bezier(0.2, 0, 0, 1)"
    }
  },
  "modes": {
    "density": {
      "$comment": "The default mode's values go on the root; .density-compact on the root (or a subtree) swaps them.",
      "default": "comfortable",
      "selector": ".density-{mode}",
      "values": {
        "comfortable": { "row-height": "36px", "stack-gap": "12px" },
        "compact": { "row-height": "28px", "stack-gap": "8px" }
      }
    }
  },
  "platforms": {
    "$comment": [
      "Each head stamps data-platform on the root element; these blocks override the base there (look.fidelity",
      "adaptive). macOS: SF Pro at 13px, larger continuous-corner radii. Windows: Segoe UI Variable at 14px, Fluent",
      "4px controls and 8px surfaces. Linux: Adwaita Sans at 14px, libadwaita 6px controls and 12px cards."
    ],
    "macos": {
      "scale": {
        "font": {
          "sans": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"SF Pro Display\", system-ui, sans-serif",
          "mono": "\"SF Mono\", ui-monospace, Menlo, monospace"
        },
        "text": {
          "xs": { "size": "10px" },
          "sm": { "size": "11px" },
          "base": { "size": "13px" },
          "lg": { "size": "15px" },
          "title": { "size": "22px" },
          "display": { "size": "26px" }
        },
        "radius": { "xs": "6px", "sm": "8px", "md": "10px", "lg": "16px", "xl": "20px" },
        "control": { "height-sm": "24px", "height-md": "30px", "height-lg": "36px" },
        "row": { "padding-y": "10px", "padding-x": "16px" }
      }
    },
    "windows": {
      "scale": {
        "font": {
          "sans": "\"Segoe UI Variable Text\", \"Segoe UI Variable\", \"Segoe UI\", system-ui, sans-serif",
          "mono": "\"Cascadia Code\", \"Cascadia Mono\", Consolas, monospace"
        },
        "text": {
          "xs": { "size": "11px" },
          "sm": { "size": "12px" },
          "base": { "size": "14px" },
          "lg": { "size": "16px" },
          "title": { "size": "20px" },
          "display": { "size": "28px" }
        },
        "radius": { "xs": "2px", "sm": "4px", "md": "4px", "lg": "8px", "xl": "8px" },
        "control": { "height-sm": "28px", "height-md": "32px", "height-lg": "40px" },
        "row": { "padding-y": "12px", "padding-x": "16px" }
      }
    },
    "linux": {
      "scale": {
        "font": {
          "sans": "\"Adwaita Sans\", Cantarell, \"Noto Sans\", system-ui, sans-serif",
          "mono": "\"Adwaita Mono\", \"DejaVu Sans Mono\", \"Noto Sans Mono\", monospace"
        },
        "text": {
          "xs": { "size": "11px" },
          "sm": { "size": "12px" },
          "base": { "size": "14px" },
          "lg": { "size": "18px" },
          "title": { "size": "20px" },
          "display": { "size": "26px" }
        },
        "radius": { "xs": "4px", "sm": "6px", "md": "8px", "lg": "12px", "xl": "12px" },
        "control": { "height-sm": "28px", "height-md": "34px", "height-lg": "40px" },
        "row": { "padding-y": "12px", "padding-x": "16px" }
      }
    }
  },
  "contrast": {
    "$comment": "WCAG 2 ratios that must hold in both themes and on each platform that overrides colours: 4.5 for text, 3 for icons, focus rings and indicator dots.",
    "rules": [
      { "fg": "ink", "bg": "bg", "min": 4.5, "label": "body text" },
      { "fg": "ink", "bg": "surface", "min": 4.5, "label": "body text on a card" },
      { "fg": "ink", "bg": "surface-well", "min": 4.5, "label": "body text in a well or sidebar" },
      { "fg": "ink", "bg": "surface-control", "min": 4.5, "label": "text in an input" },
      { "fg": "ink", "bg": "surface-popover", "min": 4.5, "label": "menu and popover text" },
      { "fg": "ink-secondary", "bg": "bg", "min": 4.5, "label": "secondary text" },
      { "fg": "ink-secondary", "bg": "surface", "min": 4.5, "label": "secondary text on a card" },
      { "fg": "ink-muted", "bg": "bg", "min": 4.5, "label": "muted text and placeholders" },
      { "fg": "ink-muted", "bg": "surface", "min": 4.5, "label": "muted text on a card" },
      { "fg": "ink-muted", "bg": "surface-well", "min": 4.5, "label": "muted text in a well" },
      { "fg": "ink-muted", "bg": "surface-control", "min": 4.5, "label": "placeholder in an input" },
      { "fg": "console-ink", "bg": "surface-console", "min": 4.5, "label": "console output" },
      { "fg": "console-muted", "bg": "surface-console", "min": 4.5, "label": "console timestamps" },
      { "fg": "console-muted", "bg": "surface-console-header", "min": 4.5, "label": "console header" },
      { "fg": "accent-ink", "bg": "bg", "min": 4.5, "label": "links and accent text" },
      { "fg": "accent-ink", "bg": "surface", "min": 4.5, "label": "links on a card" },
      { "fg": "accent-ink", "bg": "accent-soft", "min": 4.5, "label": "selected row text" },
      { "fg": "on-accent", "bg": "accent", "min": 4.5, "label": "primary button label" },
      { "fg": "on-accent", "bg": "accent-hover", "min": 4.5, "label": "primary button label, hovered" },
      { "fg": "focus", "bg": "bg", "min": 3, "label": "focus ring" },
      { "fg": "focus", "bg": "surface", "min": 3, "label": "focus ring on a card" },
      { "fg": "on-danger", "bg": "danger-fill", "min": 4.5, "label": "destructive button label" },
      { "fg": "success-fg", "bg": "bg", "min": 4.5, "label": "success text" },
      { "fg": "success-fg", "bg": "success-bg", "min": 4.5, "label": "success banner" },
      { "fg": "success-dot", "bg": "bg", "min": 3, "label": "success indicator" },
      { "fg": "warning-fg", "bg": "bg", "min": 4.5, "label": "warning text" },
      { "fg": "warning-fg", "bg": "warning-bg", "min": 4.5, "label": "warning banner" },
      { "fg": "warning-dot", "bg": "bg", "min": 3, "label": "warning indicator" },
      { "fg": "danger-fg", "bg": "bg", "min": 4.5, "label": "error text" },
      { "fg": "danger-fg", "bg": "danger-bg", "min": 4.5, "label": "error banner" },
      { "fg": "danger-dot", "bg": "bg", "min": 3, "label": "error indicator" },
      { "fg": "info-fg", "bg": "bg", "min": 4.5, "label": "info text" },
      { "fg": "info-fg", "bg": "info-bg", "min": 4.5, "label": "info banner" },
      { "fg": "info-dot", "bg": "bg", "min": 3, "label": "info indicator" }
    ],
    "separation": {
      "$comment": "Two fills a user must never confuse pass by a luminance ratio of at least min OR a hue difference of at least minHueDelta.",
      "minHueDelta": 60,
      "rules": [
        { "a": "accent", "b": "danger-fill", "min": 1.7, "label": "primary vs destructive button" }
      ]
    },
    "exceptions": {
      "$comment": "Deliberate, reasoned departures, each naming its compensating control. One that now passes fails the check."
    }
  },
  "lint": {
    "$comment": "lint.py: raw colours and sizes in hand-written UI code. design-lint-ok: <reason> on a line (or in the comment block above it) allows one.",
    "scan": ["src"],
    "extensions": [".css", ".razor", ".cs", ".html", ".js"],
    "skip": ["bin", "obj", "node_modules", "wwwroot/lib", "wwwroot/vendor"],
    "rules": {
      "raw-hex": true,
      "raw-rgb-hsl": true,
      "raw-modern-color": true,
      "named-color": true,
      "px-font-size": true,
      "magic-z-index": true,
      "raw-radius": false,
      "native-select": false
    },
    "baseline": "design/lint-baseline.json"
  }
}

{
  "$comment": "Fails tokens.py contrast four ways: muted text too light on the light ground, a primary and a destructive fill that differ by neither luminance nor hue, an exception for a pair that now passes (stale), and a primitive outside sRGB.",
  "version": 1,
  "meta": { "name": "Sample Notes" },
  "primitives": {
    "white": [1, 0, 0],
    "grey-210": [0.21, 0, 0],
    "grey-235": [0.235, 0, 0],
    "grey-720": [0.72, 0, 0],
    "grey-970": [0.97, 0, 0],
    "orange-600": [0.6, 0.16, 45],
    "red-580": [0.58, 0.2, 27],
    "neon-green": [0.8, 0.35, 140]
  },
  "semantic": {
    "light": { "bg": "white", "ink": "grey-210", "muted": "grey-720", "accent": "orange-600", "danger": "red-580",
               "highlight": "neon-green" },
    "dark": { "bg": "grey-235", "ink": "grey-970", "muted": "grey-720", "accent": "orange-600", "danger": "red-580",
              "highlight": "neon-green" }
  },
  "contrast": {
    "rules": [
      { "fg": "ink", "bg": "bg", "min": 4.5, "label": "body text" },
      { "fg": "muted", "bg": "bg", "min": 4.5, "label": "secondary text" }
    ],
    "separation": { "minHueDelta": 60, "rules": [{ "a": "accent", "b": "danger", "min": 1.7, "label": "primary vs destructive" }] },
    "exceptions": {
      "ink-was-faint": {
        "applies": "light+dark", "rule": "ink on bg",
        "reason": "Body text was once a light grey on purpose.",
        "control": "None any more: the ink was darkened, so this exception should go."
      }
    }
  }
}

{
  "$comment": "Sample Monitor: a brand accent everywhere but macOS, where it matches the system blue; per-platform radii and body size; an alpha hairline checked over its ground.",
  "version": 1,
  "meta": { "name": "Sample Monitor", "csharpPrefix": "SampleMonitor", "colorSpace": "oklch" },
  "outputs": {
    "css": "src/SampleMonitor.Ui/wwwroot/css/tokens.css",
    "csharp": { "path": "src/SampleMonitor.Core/Theme/Tokens.g.cs", "namespace": "SampleMonitor.Core.Theme",
                "scale": ["radius", "control"] },
    "design": "DESIGN.md",
    "macosAccent": { "path": "src/SampleMonitor.MacOS/Assets.xcassets/AccentColor.colorset/Contents.json", "role": "accent" }
  },
  "root": ":root",
  "primitives": {
    "white": [1, 0, 0],
    "grey-970": [0.97, 0, 0],
    "grey-500": [0.5, 0, 0],
    "grey-720": [0.72, 0, 0],
    "grey-235": [0.235, 0, 0],
    "grey-210": [0.21, 0, 0],
    "black-a22": [0, 0, 0, 0.22],
    "white-a24": [1, 0, 0, 0.24],
    "teal-500": [0.52, 0.085, 200],
    "teal-760": [0.76, 0.11, 200],
    "apple-blue": "#007aff",
    "apple-blue-dark": "#0a84ff",
    "red-500": [0.5, 0.19, 27],
    "red-720": [0.72, 0.16, 22]
  },
  "semantic": {
    "light": {
      "bg": "white", "ink": "grey-210", "muted": "grey-500", "line-strong": "black-a22",
      "accent": "teal-500", "on-accent": "white", "danger": "red-500"
    },
    "dark": {
      "bg": "grey-235", "ink": "grey-970", "muted": "grey-720", "line-strong": "white-a24",
      "accent": "teal-760", "on-accent": "grey-210", "danger": "red-720"
    }
  },
  "effects": {
    "light": { "shadow-popover": "0 10px 28px oklch(0 0 0 / 12%)" },
    "dark": { "shadow-popover": "0 14px 36px oklch(0 0 0 / 55%)" }
  },
  "scale": {
    "radius": { "$prefix": "radius-", "sm": "6px", "md": "8px", "lg": "12px" },
    "control": { "$prefix": "control-", "height-md": "30px" },
    "text": { "$prefix": "text-", "$base": "size", "body": { "size": "14px", "weight": 400, "lh": 1.45 } },
    "motion": { "$prefix": "motion-", "fast": "100ms", "ease": "cubic-bezier(0.2, 0, 0, 1)" }
  },
  "platforms": {
    "macos": {
      "attribute": "macos",
      "scale": { "radius": { "md": "10px", "lg": "16px" }, "text": { "body": { "size": "13px" } },
                 "motion": { "fast": "120ms" } },
      "semantic": { "light": { "accent": "apple-blue", "on-accent": "white" },
                    "dark": { "accent": "apple-blue-dark", "on-accent": "white" } },
      "effects": { "light": { "shadow-popover": "0 14px 36px oklch(0 0 0 / 15%)" } }
    },
    "windows": { "scale": { "radius": { "md": "4px", "lg": "8px" }, "control": { "height-md": "32px" } } },
    "linux": { "scale": { "radius": { "md": "8px" }, "control": { "height-md": "34px" } } }
  },
  "contrast": {
    "rules": [
      { "fg": "ink", "bg": "bg", "min": 4.5, "label": "body text" },
      { "fg": "muted", "bg": "bg", "min": 4.5, "label": "secondary text" },
      { "fg": "line-strong", "bg": "bg", "min": 1.5, "label": "a strong divider stays visible" },
      { "fg": "on-accent", "bg": "accent", "min": 4.5, "label": "primary button" }
    ],
    "separation": { "minHueDelta": 60, "rules": [{ "a": "accent", "b": "danger", "min": 1.7, "label": "primary vs destructive" }] },
    "exceptions": {
      "macos-system-blue": {
        "applies": "light+dark", "platforms": ["macos"], "rule": "on-accent on accent",
        "reason": "AppKit fills default buttons with the system blue and a white label (4.02:1 light, 3.65:1 dark); the macOS block matches it on purpose.",
        "control": "Only 13px semibold button labels sit on the accent; links and body text never do."
      }
    }
  }
}

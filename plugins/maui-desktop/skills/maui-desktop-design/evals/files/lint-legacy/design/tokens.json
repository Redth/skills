{
  "$comment": "Sample Notes before the migration: a token file has just been added, the hand-kept UI still has raw values. lint.py finds them; the generated tokens.css is skipped.",
  "version": 1,
  "meta": { "name": "Sample Notes" },
  "outputs": { "css": "src/SampleNotes/wwwroot/css/tokens.css" },
  "primitives": { "white": [1, 0, 0], "grey-210": [0.21, 0, 0], "grey-235": [0.235, 0, 0], "grey-970": [0.97, 0, 0] },
  "semantic": {
    "light": { "bg": "white", "ink": "grey-210" },
    "dark": { "bg": "grey-235", "ink": "grey-970" }
  },
  "lint": {
    "scan": ["src"],
    "extensions": [".css", ".razor", ".cs", ".html"],
    "skip": ["bin", "obj", "wwwroot/lib"],
    "rules": { "raw-radius": true, "native-select": true },
    "baseline": "design/lint-baseline.json"
  }
}

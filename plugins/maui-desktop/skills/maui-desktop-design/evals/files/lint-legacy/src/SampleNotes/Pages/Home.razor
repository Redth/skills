@page "/"

<div class="card" style="background: #f7f7f8; border-radius: 12px;">
    <h1 style="font-size: 20px">Notes</h1>
    <select class="sort">
        <option>Newest</option>
    </select>
    @* design-lint-ok: the brand mark's own colour, fixed by the brand guide *@
    <span class="mark" style="color: #4f46e5">S</span>
    <span class="badge" style="color: var(--accent)">New</span>
</div>

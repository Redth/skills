{
  "$comment": "A small Sample Notes token file: one accent, a neutral ladder, a status pair, a mix into a grey and a density mode.",
  "version": 1,
  "meta": { "name": "Sample Notes", "colorSpace": "oklch" },
  "outputs": {
    "css": "src/SampleNotes/wwwroot/css/tokens.css",
    "csharp": { "path": "src/SampleNotes.Core/Theme/Tokens.g.cs", "namespace": "SampleNotes.Core.Theme", "scale": ["radius"] },
    "design": "DESIGN.md",
    "ignored": ["csharp"]
  },
  "primitives": {
    "white": [1, 0, 0],
    "grey-960": [0.96, 0, 0],
    "grey-720": [0.72, 0, 0],
    "grey-500": [0.5, 0, 0],
    "grey-240": [0.24, 0, 0],
    "grey-200": [0.2, 0, 0],
    "ink-900": "#18181b",
    "ink-100": "#f4f4f5",
    "blue-500": [0.53, 0.17, 262],
    "blue-750": [0.75, 0.12, 258],
    "green-500": [0.5, 0.13, 150],
    "green-780": [0.78, 0.17, 150]
  },
  "semantic": {
    "light": {
      "bg": "white",
      "surface": "grey-960",
      "ink": "ink-900",
      "muted": "grey-500",
      "accent": "blue-500",
      "on-accent": "white",
      "accent-soft": { "mix": "blue-500", "into": "white", "amount": 0.12 },
      "ok": "green-500",
      "ok-tint": { "mix": "green-500", "into": "white", "amount": 0.12 }
    },
    "dark": {
      "bg": "grey-200",
      "surface": "grey-240",
      "ink": "ink-100",
      "muted": "grey-720",
      "accent": "blue-750",
      "on-accent": "grey-200",
      "accent-soft": { "mix": "blue-750", "into": "grey-200", "amount": 0.2 },
      "ok": "green-780",
      "ok-tint": { "mix": "green-780", "into": "grey-200", "amount": 0.18 }
    }
  },
  "effects": {
    "light": { "shadow-popover": "0 10px 28px oklch(0 0 0 / 12%)" },
    "dark": { "shadow-popover": "0 14px 36px oklch(0 0 0 / 55%)" }
  },
  "scale": {
    "space": { "$prefix": "space-", "1": "4px", "2": "8px" },
    "radius": { "$prefix": "radius-", "sm": "6px", "md": "8px", "lg": "12px" },
    "text": { "$prefix": "text-", "$base": "size", "body": { "size": "0.875rem", "weight": 400, "lh": 1.45 } },
    "z": { "$prefix": "z-", "popover": 30, "dialog": 40 },
    "motion": { "$prefix": "motion-", "fast": "100ms", "slow": "240ms", "ease": "cubic-bezier(0.2, 0, 0, 1)" }
  },
  "modes": {
    "density": { "default": "comfortable", "selector": ".density-{mode}",
                 "values": { "comfortable": { "row-h": "36px" }, "compact": { "row-h": "28px" } } }
  },
  "contrast": {
    "rules": [
      { "fg": "ink", "bg": "bg", "min": 4.5, "label": "body text" },
      { "fg": "ink", "bg": "surface", "min": 4.5, "label": "body on a card" },
      { "fg": "muted", "bg": "bg", "min": 4.5, "label": "secondary text" },
      { "fg": "on-accent", "bg": "accent", "min": 4.5, "label": "primary button" },
      { "fg": "ok", "bg": "ok-tint", "min": 4.5, "label": "success pill" }
    ],
    "separation": { "minHueDelta": 60, "rules": [{ "a": "accent", "b": "ok", "min": 1.7, "label": "primary vs success" }] }
  }
}

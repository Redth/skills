<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>SampleNotes</RootNamespace>
    <ApplicationId>com.example.samplenotes</ApplicationId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SampleNotes.Core\SampleNotes.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SampleNotes\**\*.cs" Exclude="..\SampleNotes\Platforms\**\*.cs" />
    <RazorComponent Include="..\SampleNotes\**\*.razor" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

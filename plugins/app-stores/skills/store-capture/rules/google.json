        "minSide": 1080,
        "maxSide": 7680,
        "minAspect": 1.77,
        "maxAspect": 1.78
      },
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9866151",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "Large screens: each side 1080-7680 px, 16:9 or 9:16."
    },
    {
      "id": "google.screenshots.wear.size",

          "phone",
          "tv"
        ]
      },
      "range": {
        "minSide": 320,
        "maxSide": 3840,
        "maxAspect": 2
      },
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9866151",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "Each side 320-3840 px; the long side no more than twice the short."
    },
    {
      "id": "google.screenshots.tablet.size",

    },
    {
      "id": "google.screenshots.tv.unaltered",
      "kind": "checklist",
      "applies": {
        "slot": "tv"
      },
      "item": "At least one TV screenshot is unaltered: the app at full resolution, with no caption or art over it (TV quality TV-G4).",
      "when": {
        "slotUsed": "tv"
      },
      "severity": "warning",
      "source": "https://developer.android.com/docs/quality-guidelines/tv-app-quality",
      "checked": "2026-11-14",
      "status": "verified"

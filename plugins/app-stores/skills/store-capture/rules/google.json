      "source": "https://support.google.com/googleplay/android-developer/answer/9866151",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "JPEG or 24-bit PNG, no alpha."
    },
    {
      "id": "google.screenshots.file_size",
      "kind": "format",
      "applies": {
        "slots": [
          "phone",
          "tablet7",
          "tablet10",
          "tv",
          "wear"
        ]
      },
      "maxBytes": 8388608,
      "severity": "warning",
      "source": "https://support.google.com/googleplay/android-developer/answer/9866151",
      "checked": "2026-11-14",
      "status": "unverified",
      "note": "Google states no file size for phone, tablet, TV or Wear screenshots (Android XR's are 8 MB); 8 MB is a cautious cap."
    },
    {
      "id": "google.screenshots.phone.size",
      "kind": "size",
      "applies": {

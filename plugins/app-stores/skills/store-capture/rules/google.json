{
  "$schema": "./rules.schema.json",
  "$comment": "Google Play's listing rules, from Google's own pages read on the date in 'checked'. Each rule's 'status' says how sure we are: a rule that isn't 'verified' is reported as a warning whatever its severity. Google separates requirements (removal or suspension) from 'highly recommended' (promotion only): the second are warnings here. To update a rule, change its values, 'source', 'checked' and 'status' together; never change an 'id'.",
  "store": "google",
  "checked": "2026-11-14",
  "rules": [
    {
      "id": "google.title.length",
      "kind": "limit",
      "applies": {
        "field": "google.title"
      },
      "max": 30,
      "count": "characters",
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9898842",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "Full-width and half-width characters each count as one."
    },
    {
      "id": "google.title.required",
      "kind": "required",
      "applies": {
        "field": "google.title"
      },
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9859152",
      "checked": "2026-11-14",
      "status": "verified"
    },
    {
      "id": "google.title.emoji",
      "kind": "pattern",
      "applies": {
        "field": "google.title"
      },
      "regex": "[\\U0001F000-\\U0001FAFF\\U0001F1E6-\\U0001F1FF\\u2600-\\u27BF\\u2B00-\\u2BFF\\uFE0F\\u200D]",
      "forbid": true,
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9898842",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "Metadata policy: no emoji or emoticons in the app's name. Kaomoji aren't caught by the pattern: look for them."
    },
    {
      "id": "google.title.all_caps",
      "kind": "pattern",
      "applies": {
        "field": "google.title"
      },
      "regex": "^(?=(?:[^A-Za-z]*[A-Z]){3})[^a-z]*$",
      "forbid": true,
      "severity": "warning",
      "source": "https://support.google.com/googleplay/android-developer/answer/9898842",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "No ALL CAPS unless it's the brand's own styling."
    },
    {
      "id": "google.title.repeated_symbols",
      "kind": "pattern",
      "applies": {
        "field": "google.title"
      },
      "regex": "([^\\w\\s])\\1{2,}",
      "forbid": true,
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9898842",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "No repeated or misleading special characters (three or more in a row here)."
    },
    {
      "id": "google.title.promotional",
      "kind": "words",
      "applies": {
        "field": "google.title"
      },
      "words": [
        "free",
        "#1",
        "no. 1",
        "number one",
        "best",
        "top",
        "top rated",
        "new",
        "sale",
        "discount",
        "% off",
        "cheap",
        "limited time",
        "popular",
        "million downloads",
        "app of the year",
        "game of the year",
        "editor's choice",
        "editors' choice",
        "best of play"
      ],
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9898842",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "Nothing about store performance or ranking, price or promotion, or Play programs ('New', 'Editor's Choice'). 'new' also matches 'New York': relax by id when it's part of the name."
    },
    {
      "id": "google.short_description.length",
      "kind": "limit",
      "applies": {
        "field": "google.shortDescription"
      },
      "max": 80,
      "count": "characters",
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9866151",
      "checked": "2026-11-14",
      "status": "verified"
    },
    {
      "id": "google.short_description.required",
      "kind": "required",
      "applies": {
        "field": "google.shortDescription"
      },
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9859152",
      "checked": "2026-11-14",
      "status": "verified"
    },
    {
      "id": "google.short_description.emoji",
      "kind": "pattern",
      "applies": {
        "field": "google.shortDescription"
      },
      "regex": "[\\U0001F000-\\U0001FAFF\\U0001F1E6-\\U0001F1FF\\u2600-\\u27BF\\u2B00-\\u2BFF\\uFE0F\\u200D]",
      "forbid": true,
      "severity": "warning",
      "source": "https://support.google.com/googleplay/android-developer/answer/9866151",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "Highly recommended against (not a policy rule here, unlike the title)."
    },
    {
      "id": "google.short_description.line_breaks",
      "kind": "pattern",
      "applies": {
        "field": "google.shortDescription"
      },
      "regex": "[\\r\\n]",
      "forbid": true,
      "severity": "warning",
      "source": "https://support.google.com/googleplay/android-developer/answer/9866151",
      "checked": "2026-11-14",
      "status": "verified"
    },
    {
      "id": "google.short_description.promotional",
      "kind": "words",
      "applies": {
        "field": "google.shortDescription"
      },
      "words": [
        "free",
        "#1",
        "no. 1",
        "number one",
        "best",
        "top",
        "top rated",
        "new",
        "sale",
        "discount",
        "% off",
        "cheap",
        "limited time",
        "popular",
        "million downloads",
        "app of the year",
        "game of the year",
        "editor's choice",
        "editors' choice",
        "best of play",
        "download now",
        "install now",
        "play now",
        "get it now",
        "try now",
        "buy now"
      ],
      "severity": "warning",
      "source": "https://support.google.com/googleplay/android-developer/answer/9866151",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "Highly recommended against: ranking, price, promotion and award language, and calls to action."
    },
    {
      "id": "google.full_description.length",
      "kind": "limit",
      "applies": {
        "field": "google.fullDescription"
      },
      "max": 4000,
      "count": "characters",
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9859152",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "Falls back to the locale's shared description."
    },
    {
      "id": "google.full_description.required",
      "kind": "required",
      "applies": {
        "field": "google.fullDescription"
      },
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9859152",
      "checked": "2026-11-14",
      "status": "verified"
    },
    {
      "id": "google.full_description.claims",
      "kind": "words",
      "applies": {
        "field": "google.fullDescription"
      },
      "words": [
        "#1",
        "no. 1",
        "number one",
        "best",
        "top rated",
        "best game ever",
        "best app ever"
      ],
      "severity": "warning",
      "source": "https://support.google.com/googleplay/android-developer/answer/9898842",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "No deceptive claims ('best game ever'). 'Free' is allowed in the full description."
    },
    {
      "id": "google.full_description.testimonials",
      "kind": "checklist",
      "applies": {
        "field": "google.fullDescription"
      },
      "item": "No unattributed or anonymous testimonials, no comparisons with other apps' data, no repeated or unrelated keywords or keyword lists.",
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9898842",
      "checked": "2026-11-14",
      "status": "verified"
    },
    {
      "id": "google.full_description.android_tv",
      "kind": "pattern",
      "applies": {
        "field": "google.fullDescription"
      },
      "regex": "Android TV",
      "when": {
        "slotUsed": "tv"
      },
      "severity": "error",
      "source": "https://developer.android.com/training/tv/publishing/distribute",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "An app opted in to Android TV says 'Android TV' in its description."
    },
    {
      "id": "google.release_notes.length",
      "kind": "limit",
      "applies": {
        "field": "google.releaseNotes"
      },
      "max": 500,
      "count": "characters",
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9859348",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "'500 Unicode characters' per language; sent with a release, not the listing."
    },
    {
      "id": "google.video.youtube",
      "kind": "pattern",
      "applies": {
        "field": "google.video"
      },
      "regex": "^(https?://(www\\.|m\\.)?youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}|https?://youtu\\.be/[A-Za-z0-9_-]{11})$",
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9866151",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "One YouTube video's URL: no playlist, channel or start time."
    },
    {
      "id": "google.video.watch_form",
      "kind": "pattern",
      "applies": {
        "field": "google.video"
      },
      "regex": "^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$",
      "severity": "warning",
      "source": "https://support.google.com/googleplay/android-developer/answer/9866151",
      "checked": "2026-11-14",
      "status": "unverified",
      "note": "Only the https://www.youtube.com/watch?v=<id> form is known to be taken; youtu.be and Shorts links are unverified."
    },
    {
      "id": "google.video.settings",
      "kind": "checklist",
      "applies": {
        "field": "google.video"
      },
      "item": "The video is public or unlisted, embeddable, with ads off and no age restriction; the real experience in the first 10 seconds.",
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9866151",
      "checked": "2026-11-14",
      "status": "verified"
    },
    {
      "id": "google.contact.email.required",
      "kind": "required",
      "applies": {
        "field": "app.contact.email"
      },
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9859152",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "Shown publicly."
    },
    {
      "id": "google.contact.website",
      "kind": "required",
      "applies": {
        "field": "app.contact.website"
      },
      "severity": "warning",
      "source": "https://support.google.com/googleplay/android-developer/answer/9859152",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "Recommended; the phone is optional."
    },
    {
      "id": "google.urls.privacy.required",
      "kind": "required",
      "applies": {
        "field": "app.urls.privacy"
      },
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9859455",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "A public privacy policy URL in the listing, and the policy reachable in the app too."
    },
    {
      "id": "google.metadata.other_platforms",
      "kind": "words",
      "applies": {
        "fields": [
          "google.title",
          "google.shortDescription",
          "google.fullDescription",
          "captions"
        ]
      },
      "words": [
        "iPhone",
        "iPad",
        "iOS",
        "iPadOS",
        "App Store",
        "Apple TV",
        "macOS",
        "Mac App Store",
        "TestFlight"
      ],
      "severity": "warning",
      "source": "https://support.google.com/googleplay/android-developer/answer/9898842",
      "checked": "2026-11-14",
      "status": "unverified",
      "note": "No Play policy names other platforms; a judgement: they mean nothing to a Play shopper."
    },
    {
      "id": "google.metadata.placeholder_text",
      "kind": "words",
      "applies": {
        "fields": [
          "google.title",
          "google.shortDescription",
          "google.fullDescription",
          "captions"
        ]
      },
      "words": [
        "lorem ipsum",
        "lorem",
        "placeholder",
        "TODO",
        "TBD",
        "FIXME",
        "coming soon",
        "[insert",
        "your text here"
      ],
      "severity": "warning",
      "source": "https://support.google.com/googleplay/android-developer/answer/9898842",
      "checked": "2026-11-14",
      "status": "unverified",
      "note": "Listings should reflect the real, finished app. fastlane precheck's placeholder_text."
    },
    {
      "id": "google.captions.promotional",
      "kind": "words",
      "applies": {
        "field": "captions"
      },
      "words": [
        "free",
        "#1",
        "no. 1",
        "number one",
        "best",
        "top",
        "top rated",
        "new",
        "sale",
        "discount",
        "% off",
        "cheap",
        "limited time",
        "popular",
        "million downloads",
        "app of the year",
        "game of the year",
        "editor's choice",
        "editors' choice",
        "best of play",
        "download now",
        "install now",
        "play now",
        "get it now",
        "try now",
        "buy now",
        "$",
        "€",
        "£",
        "award",
        "award-winning"
      ],
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9866151",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "Screenshots and the feature graphic: no 'Best', '#1', 'Top', 'New', 'Free', 'Discount', 'Sale', 'Million Downloads', awards, prices, calls to action or store badges. Google lists these as highly recommended for images, and its metadata policy covers ranking and price claims in promotional images: treated as errors."
    },
    {
      "id": "google.screenshots.count",
      "kind": "count",
      "applies": {
        "slots": [
          "phone",
          "tablet7",
          "tablet10",
          "tv",
          "wear"
        ]
      },
      "min": 0,
      "max": 8,
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9866151",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "Up to 8 per device type, per language."
    },
    {
      "id": "google.screenshots.minimum",
      "kind": "count",
      "applies": {
        "slots": [
          "phone",
          "tablet7",
          "tablet10",
          "tv",
          "wear"
        ]
      },
      "min": 2,
      "across": true,
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9866151",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "At least two screenshots across the device types to publish."
    },
    {
      "id": "google.screenshots.format",
      "kind": "format",
      "applies": {
        "slots": [
          "phone",
          "tablet7",
          "tablet10",
          "tv",
          "wear"
        ]
      },
      "formats": [

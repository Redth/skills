      "checked": "2026-11-14",
      "status": "verified",
      "note": "Four or more recommended (for promotion); not required."
    },
    {
      "id": "google.screenshots.tablet10.count",
      "kind": "count",
      "applies": {
        "slot": "tablet10"
      },
      "min": 4,
      "when": {
        "slotUsed": "tablet10"
      },
      "severity": "warning",
      "source": "https://support.google.com/googleplay/android-developer/answer/9866151",
      "checked": "2026-11-14",
      "status": "verified",
      "note": "Four or more recommended (for promotion); not required."
    },
    {

  "slots": {
    "$comment": "Google Play's image types (the API's AppImageType). 'group' is screenshots or graphics. Which config screen fills a screenshot slot is stores.google.slots; graphics come from stores.google.graphics. Counts are per language. Sizes: 'range' is minSide/maxSide in pixels and long side over short side (minAspect, maxAspect); 'sizes' are exact.",
    "phone": {
      "imageType": "phoneScreenshots",
      "group": "screenshots",
      "kind": "phone",
      "count": {
        "min": 0,
        "max": 8
      },
      "range": {
        "minSide": 320,
        "maxSide": 3840,
        "maxAspect": 2
      },
      "formats": [
        "png",
        "jpeg"
      ],
      "alpha": false,
      "status": "verified"
    },
    "tablet7": {
      "imageType": "sevenInchScreenshots",
      "group": "screenshots",
      "kind": "tablet",
      "count": {
        "min": 0,
        "max": 8
      },
      "range": {
        "minSide": 1080,
        "maxSide": 7680,
        "minAspect": 1.77,
        "maxAspect": 1.78
      },
      "formats": [
        "png",
        "jpeg"
      ],
      "alpha": false,
      "status": "verified",
      "note": "16:9 or 9:16. Four or more recommended. Chromebook shots go only through Play Console."
    },
    "tablet10": {
      "imageType": "tenInchScreenshots",
      "group": "screenshots",
      "kind": "tablet",
      "count": {
        "min": 0,
        "max": 8
      },
      "range": {
        "minSide": 1080,
        "maxSide": 7680,
        "minAspect": 1.77,
        "maxAspect": 1.78
      },
      "formats": [
        "png",
        "jpeg"
      ],
      "alpha": false,
      "status": "verified",
      "note": "16:9 or 9:16. Four or more recommended."
    },
    "tv": {
      "imageType": "tvScreenshots",
      "group": "screenshots",
      "kind": "tv",
      "count": {
        "min": 0,
        "max": 8
      },

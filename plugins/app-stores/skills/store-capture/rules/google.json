    {
      "id": "google.screenshots.content",
      "kind": "checklist",
      "applies": {
        "slots": [
          "phone",
          "tablet7",
          "tablet10",
          "tv",
          "wear"
        ]
      },
      "item": "Screenshots show the real experience, the UI first in the first three; taglines no more than 20% of the picture; a tidy status bar; no device frames or added backgrounds (recommended), no people's fingers on a device. Panoramas are fine.",
      "severity": "warning",
      "source": "https://support.google.com/googleplay/android-developer/answer/9866151",
      "checked": "2026-11-14",
      "status": "verified"
    },
    {
      "id": "google.icon.required",
      "kind": "required",
      "applies": {
        "slot": "icon"
      },

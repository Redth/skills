      "note": "1:1, at least 384x384."
    },
    {
      "id": "google.screenshots.wear.plain",
      "kind": "checklist",
      "applies": {
        "slot": "wear"
      },
      "item": "Wear OS screenshots show only the app's interface: no device frames, extra text, graphics or backgrounds, no transparency or masking (a requirement for Wear, not a recommendation). A Tiles shot if the app has Tiles.",
      "when": {
        "slotUsed": "wear"
      },
      "severity": "error",
      "source": "https://support.google.com/googleplay/android-developer/answer/9866151",
      "checked": "2026-11-14",
      "status": "verified"
    },
    {

                  "wmSize": "1080x1920", "density": 420 } },
    { "id": "fold-outer", "platform": "android", "kind": "phone", "driver": "adb", "width": 1080, "height": 1920,
      "target": { "systemImage": "system-images;android-36;google_apis;arm64-v8a", "profile": "pixel_9_pro_fold",
                  "wmSize": "1080x1920", "density": 420, "display": "4619827551948147201" } },
    { "id": "fold-inner", "platform": "android", "kind": "tablet", "driver": "adb", "width": 1920, "height": 1080,
      "target": { "systemImage": "system-images;android-36;google_apis;arm64-v8a", "profile": "pixel_9_pro_fold",
                  "wmSize": "1920x1080", "density": 320, "display": "4619827259835644672" } },
    { "id": "duo-inner", "platform": "ios", "kind": "phone", "driver": "appium", "width": 2007, "height": 2853,
